# Copiá este archivo a .env y completá las dos claves. El .env no se sube a git.
# Solo para correr en tu compu con docker compose.

# Clave del usuario sa de SQL Server: mínimo 8 caracteres, con mayúsculas, minúsculas y números.
# Usá solo letras, números y guiones: un ; o un $ rompen la cadena de conexión.
SA_PASSWORD=

# Clave del administrador de la aplicación (admin@sca.com): 6 caracteres o más, con un número.
ADMIN_PASSWORD=
