<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1280, initial-scale=1.0" />
    <title>@ViewData["Title"] - SCA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.2/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>(function(){var t=localStorage.getItem('sca-theme');if(t)document.documentElement.setAttribute('data-theme',t);else document.documentElement.removeAttribute('data-theme');})();</script>
</head>
<body>
    <div class="shader"><div class="orb o1"></div><div class="orb o2"></div></div>

    <aside class="side">
        <div class="side-line">
            <div class="side-brand">
                <img src="~/images/logo.png" alt="SCA" />
                <h1>Control de Almuerzos</h1>
            </div>
        </div>
        <div class="side-nav">
            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            }
            <nav>
                @if (User.IsInRole("Admin"))
                {
                    <!-- Nav exclusiva del Administrador -->
                    <a asp-controller="Admin" asp-action="Index" class="mi @(controller == "Admin" ? "active" : "")" data-tip="Inicio">
                        <div class="bar"></div>
                        <div class="ico ico-bi"><i class="bi bi-house-door"></i></div>
                        <span class="lbl">INICIO</span>
                    </a>
                    <a asp-controller="Empresa" asp-action="Index" class="mi @(controller == "Empresa" ? "active" : "")" data-tip="Empresas">
                        <div class="bar"></div>
                        <div class="ico ico-bi"><i class="bi bi-building"></i></div>
                        <span class="lbl">EMPRESAS</span>
                    </a>
                    <a asp-controller="Empleado" asp-action="Index" class="mi @(controller == "Empleado" ? "active" : "")" data-tip="Empleados">
                        <div class="bar"></div>
                        <div class="ico ico-bi"><i class="bi bi-people"></i></div>
                        <span class="lbl">EMPLEADOS</span>
                    </a>
                    <a asp-controller="Estadistica" asp-action="Index" class="mi @(controller == "Estadistica" ? "active" : "")" data-tip="Estadísticas">
                        <div class="bar"></div>
                        <div class="ico ico-bi"><i class="bi bi-bar-chart"></i></div>
                        <span class="lbl">ESTADÍSTICAS</span>
                    </a>
                    <a asp-controller="Usuario" asp-action="Index" class="mi @(controller == "Usuario" ? "active" : "")" data-tip="Usuarios">
                        <div class="bar"></div>
                        <div class="ico ico-bi"><i class="bi bi-shield-lock"></i></div>
                        <span class="lbl">USUARIOS</span>
                    </a>
                }
                else
                {
                    <!-- Nav operacional para usuarios regulares -->
                    <a asp-controller="Home" asp-action="Index" class="mi @(controller == "Home" ? "active" : "")" data-tip="Inicio">
                        <div class="bar"></div>
                        <div class="ico ico-bi"><i class="bi bi-house-door"></i></div>
                        <span class="lbl">INICIO</span>
                    </a>
                    <a asp-controller="Servicio" asp-action="Index" class="mi @(controller == "Servicio" ? "active" : "")" data-tip="Servicios">
                        <div class="bar"></div>
                        <div class="ico ico-bi"><i class="bi bi-calendar-check"></i></div>
                        <span class="lbl">SERVICIOS</span>
                    </a>
                    <a asp-controller="Registro" asp-action="Index" class="mi @(controller == "Registro" ? "active" : "")" data-tip="Registro Manual">
                        <div class="bar"></div>
                        <div class="ico ico-bi"><i class="bi bi-person-lines-fill"></i></div>
                        <span class="lbl">REGISTRO MANUAL</span>
                    </a>
                    <a asp-controller="Reporte" asp-action="Index" class="mi @(controller == "Reporte" ? "active" : "")" data-tip="Reportes">
                        <div class="bar"></div>
                        <div class="ico ico-bi"><i class="bi bi-file-earmark-bar-graph"></i></div>
                        <span class="lbl">REPORTES</span>
                    </a>
                }
            </nav>
        </div>
        <div class="side-footer">
            <button class="theme-btn" id="theme-toggle" title="Solar / Marino">
                <i class="bi bi-palette2"></i>
            </button>
        </div>
    </aside>

    <div class="right-panel">
        <nav class="topbar">
            <div class="topbar-datetime">
                <i class="bi bi-calendar3"></i>
                <span id="topbar-fecha"></span>
                <span class="topbar-sep">·</span>
                <i class="bi bi-clock"></i>
                <span id="topbar-hora"></span>
            </div>
            <div class="user-area">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var nombreUsuario = User.FindFirst("NombreUsuario")?.Value ?? User.Identity.Name ?? "usuario";
                    <div class="pill">
                        <div class="avatar"><i class="bi bi-person-circle"></i></div>
                        <span class="uname">@nombreUsuario</span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="logout" title="Cerrar sesión">
                            <i class="bi bi-power"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="pill">
                        <div class="avatar"><i class="bi bi-person"></i></div>
                        <span class="uname">Iniciar Sesión</span>
                    </a>
                }
            </div>
        </nav>

        <main class="content">
            @RenderBody()
        </main>

        <footer class="foot">
            <p>Sistema Control de Almuerzos &mdash; v1.0 &mdash; 2026</p>
        </footer>
    </div>

    <!-- Toast Container -->
    <div class="sca-toast-container" id="sca-toast-container"></div>

    <partial name="_Notificaciones" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            const dias = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
            const meses = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
            function actualizar() {
                const now = new Date();
                const fecha = `${dias[now.getDay()]} ${now.getDate()} de ${meses[now.getMonth()]}`;
                const hora = now.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                document.getElementById('topbar-fecha').textContent = fecha;
                document.getElementById('topbar-hora').textContent = hora;
            }
            actualizar();
            setInterval(actualizar, 1000);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function () {
            var btn = document.getElementById('theme-toggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var current = document.documentElement.getAttribute('data-theme');
                var next = current === 'marino' ? '' : 'marino';
                if (next) document.documentElement.setAttribute('data-theme', next);
                else document.documentElement.removeAttribute('data-theme');
                localStorage.setItem('sca-theme', next);
            });
        })();
    </script>
</body>
</html>
